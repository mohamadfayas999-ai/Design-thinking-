# WASHWISE AI Service — Environment Configuration
# ================================================
# Copy this file to .env and adjust values.

# AI mode: "mock" for development (no model needed), "production" for real inference
AI_MODE=mock

# Path to your trained YOLOv8 clothing model
MODEL_PATH=./models/clothing_yolov8.pt

# Detection confidence threshold (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.50

# Port to run the AI service on
PORT=8000

# Maximum allowed image size in MB
MAX_IMAGE_SIZE_MB=10
