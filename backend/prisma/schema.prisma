generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnvironmentType {
  COLLEGE
  PG_SHARED
}

model Hostel {
  id                 String              @id @default(cuid())
  name               String              @unique
  code               String              @unique
  description        String?
  environment        EnvironmentType     @default(COLLEGE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  laundryOrders      LaundryOrder[]
  laundrySlots       LaundrySlot[]
  rackShelfLocations RackShelfLocation[]
  staff              StaffProfile[]
  students           StudentProfile[]
  users              User[]

  @@index([environment])
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  role           String
  hostelId       String?
  environment    EnvironmentType @default(COLLEGE)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  auditLogs      AuditLog[]      @relation("UserAuditLogs")
  notifications  Notification[]
  staffProfile   StaffProfile?
  studentProfile StudentProfile?
  hostel         Hostel?         @relation(fields: [hostelId], references: [id])

  @@index([email])
  @@index([role])
  @@index([environment])
}

model StudentProfile {
  id               String           @id @default(cuid())
  userId           String           @unique
  studentId        String           @unique
  name             String
  department       String
  admissionYear    Int
  hostelId         String
  permanentQrToken String           @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  complaints       Complaint[]
  laundryHistories LaundryHistory[]
  laundryOrders    LaundryOrder[]
  slotBookings     SlotBooking[]
  hostel           Hostel           @relation(fields: [hostelId], references: [id])
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hostelId])
}

model StaffProfile {
  id            String         @id @default(cuid())
  userId        String         @unique
  staffId       String         @unique
  name          String
  hostelId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  laundryOrders LaundryOrder[]
  hostel        Hostel         @relation(fields: [hostelId], references: [id])
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hostelId])
}

model LaundrySlot {
  id           String        @id @default(cuid())
  hostelId     String
  date         String
  startTime    String
  endTime      String
  capacity     Int           @default(10)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  hostel       Hostel        @relation(fields: [hostelId], references: [id])
  slotBookings SlotBooking[]

  @@index([hostelId, date])
}

model SlotBooking {
  id           String         @id @default(cuid())
  studentId    String
  slotId       String
  status       String         @default("BOOKED")
  batchGroupId String?
  batchNumber  Int            @default(1)
  totalBatches Int            @default(1)
  weightGrams  Int?
  bookedAt     DateTime       @default(now())
  cancelledAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  aiScan       AiScan?
  laundryOrder LaundryOrder?
  slot         LaundrySlot    @relation(fields: [slotId], references: [id])
  student      StudentProfile @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([slotId])
  @@index([batchGroupId])
}

model ItemCount {
  id                 String        @id @default(cuid())
  tShirtShirtCount   Int           @default(0)
  pantsTrackCount    Int           @default(0)
  totalCount         Int           @default(0)
  shirtCount         Int           @default(0)
  tshirtCount        Int           @default(0)
  pantsCount         Int           @default(0)
  jeansCount         Int           @default(0)
  shortsCount        Int           @default(0)
  totalWeightGrams   Int           @default(0)
  unmappedReviewJson String?
  isLocked           Boolean       @default(false)
  lockedAt           DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  laundryOrder       LaundryOrder?
}

model RackShelfLocation {
  id            String         @id @default(cuid())
  hostelId      String
  rackNumber    Int
  shelfNumber   Int
  label         String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  laundryOrders LaundryOrder[]
  hostel        Hostel         @relation(fields: [hostelId], references: [id])

  @@unique([hostelId, rackNumber, shelfNumber])
}

model LaundryOrder {
  id          String             @id @default(cuid())
  studentId   String
  bookingId   String             @unique
  hostelId    String
  staffId     String?
  rackShelfId String?
  itemCountId String?            @unique
  status      String             @default("BOOKED")
  submittedAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  verifiedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  aiScan      AiScan?
  complaint   Complaint?
  histories   LaundryHistory[]
  booking     SlotBooking        @relation(fields: [bookingId], references: [id])
  hostel      Hostel             @relation(fields: [hostelId], references: [id])
  itemCount   ItemCount?         @relation(fields: [itemCountId], references: [id])
  rackShelf   RackShelfLocation? @relation(fields: [rackShelfId], references: [id])
  staff       StaffProfile?      @relation(fields: [staffId], references: [id])
  student     StudentProfile     @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([hostelId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("LAUNDRY_COMPLETED")
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Complaint {
  id                String         @id @default(cuid())
  laundryOrderId    String         @unique
  studentId         String
  type              String
  additionalDetails String?
  status            String         @default("UNDER_REVIEW")
  createdAt         DateTime       @default(now())
  resolvedAt        DateTime?
  laundryOrder      LaundryOrder   @relation(fields: [laundryOrderId], references: [id])
  student           StudentProfile @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([status])
}

model LaundryHistory {
  id               String         @id @default(cuid())
  studentId        String
  laundryOrderId   String?
  bookingDate      String
  slotTiming       String
  clothesCount     Int
  processStartedAt DateTime?
  completedAt      DateTime?
  finalOutcome     String
  complaintType    String?
  complaintDetails String?
  complaintStatus  String?
  resolvedAt       DateTime?
  createdAt        DateTime       @default(now())
  laundryOrder     LaundryOrder?  @relation(fields: [laundryOrderId], references: [id])
  student          StudentProfile @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  oldValue    String?
  newValue    String?
  reason      String?
  createdAt   DateTime @default(now())
  actorUser   User?    @relation("UserAuditLogs", fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
}

model AiScan {
  id                      String        @id @default(cuid())
  studentId               String
  hostelId                String
  bookingId               String?       @unique
  laundryOrderId          String?       @unique
  visibleClothingCount    Int
  clothingType            String
  mainColor               String
  possibleStain           String
  stainSeverity           String
  confidence              String        @default("Medium")
  itemsJson               String?
  washMode                String
  preTreatment            String
  detergentLevel          String
  staffConfirmed          Boolean       @default(false)
  confirmedType           String?
  confirmedColor          String?
  confirmedStain          String?
  confirmedSeverity       String?
  confirmedWashMode       String?
  confirmedPreTreatment   String?
  confirmedRecommendation String?
  confirmedAt             DateTime?
  confirmedByStaffId      String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  slotBooking             SlotBooking?  @relation(fields: [bookingId], references: [id])
  laundryOrder            LaundryOrder? @relation(fields: [laundryOrderId], references: [id])

  @@index([studentId])
  @@index([hostelId])
}
